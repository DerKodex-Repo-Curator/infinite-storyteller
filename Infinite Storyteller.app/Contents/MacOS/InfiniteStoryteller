#!/bin/bash
# Launcher for Infinite Storyteller. Must stay next to the project folder.
set -u

APP_DIR="$(cd "$(dirname "$0")/../.." && pwd)"
PROJECT="$(cd "$APP_DIR/.." && pwd)"
LOG="$PROJECT/launcher.log"
cd "$PROJECT" || {
  /usr/bin/osascript -e 'display alert "Infinite Storyteller" message "Could not find the project folder next to Infinite Storyteller.app. Keep the .app inside the infinite-storyteller folder." as critical'
  exit 1
}

export PATH="$HOME/.local/bin:/Applications/Ollama.app/Contents/Resources:/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:$PATH"

{
  echo "==== $(date) ===="
  echo "PROJECT=$PROJECT"
  echo "PWD=$(pwd)"
  echo "python=$(/usr/bin/python3 -V 2>&1)"
} >>"$LOG" 2>&1

alert() {
  /usr/bin/osascript -e "display alert \"Infinite Storyteller\" message \"$1\" as critical" >/dev/null 2>&1 || true
}

if [[ ! -f "$PROJECT/gui_web.py" ]]; then
  alert "Missing gui_web.py next to the app. Keep Infinite Storyteller.app inside the infinite-storyteller project folder."
  exit 1
fi

# Stop prior GUI servers so we always run the newest code
/usr/bin/pkill -f "$PROJECT/gui.py" >/dev/null 2>&1 || true
/usr/bin/pkill -f "$PROJECT/gui_web.py" >/dev/null 2>&1 || true
sleep 0.5

# Start Ollama locally if installed (no internet required — models are already downloaded)
if [[ -d "/Applications/Ollama.app" ]]; then
  /usr/bin/open -a Ollama >/dev/null 2>&1 || true
fi

# Wait briefly for anything still holding port 8765
for _ in 1 2 3 4 5; do
  if ! /usr/sbin/lsof -nP -iTCP:8765 -sTCP:LISTEN >/dev/null 2>&1; then
    break
  fi
  sleep 0.4
done

# Launch the web UI. If it crashes, surface the error in a dialog + log.
/usr/bin/python3 "$PROJECT/gui_web.py" >>"$LOG" 2>&1
STATUS=$?
if [[ $STATUS -ne 0 ]]; then
  TAIL=$(/usr/bin/tail -n 20 "$LOG" 2>/dev/null | /usr/bin/tr '\n' ' ' | /usr/bin/cut -c1-400)
  alert "The game failed to start (exit $STATUS). Open Terminal and run:  python3 \"$PROJECT/gui_web.py\"  — see launcher.log. Last lines: $TAIL"
fi
exit "$STATUS"
